# Пример конфигурации серверной части HabitQuest.
# Скопируйте файл в .env и при необходимости измените значения.

# Строка подключения SQLAlchemy.
# SQLite (по умолчанию): файл habitquest.db рядом с папкой backend.
DATABASE_URL=sqlite:///./habitquest.db

# PostgreSQL. Строку можно вставлять в том виде, в каком её выдаёт хостинг:
# приложение само подставит нужный драйвер, поэтому оба варианта равнозначны.
# DATABASE_URL=postgresql://habitquest:пароль@хост:5432/habitquest
# DATABASE_URL=postgresql+psycopg://habitquest:пароль@хост:5432/habitquest

# Секретный ключ для подписи JWT. ОБЯЗАТЕЛЬНО замените на своё длинное значение.
SECRET_KEY=change-me-to-a-long-random-secret-string

# Алгоритм подписи JWT.
ALGORITHM=HS256

# Время жизни access-токена в минутах (по умолчанию 7 суток).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Разрешённые источники CORS через запятую.
# При публикации обязательно добавьте адрес опубликованного фронтенда.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Пример для фронтенда, опубликованного на GitHub Pages:
# CORS_ORIGINS=https://sacura1337.github.io,http://localhost:5173

# Каталог для загруженных аватаров (относительный путь — от папки backend).
UPLOAD_DIR=uploads
