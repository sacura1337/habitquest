# Единый стиль переводов строк для всей команды (Windows + Linux)
* text=auto eol=lf

# Двоичные файлы — Git не должен менять в них байты
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.svg text eol=lf

# Служебные файлы, которые не нужно показывать в статистике языка
package-lock.json linguist-generated=true
